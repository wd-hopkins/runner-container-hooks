{
  "name": "kubehooks",
  "version": "0.1.0",
  "description": "",
  "main": "lib/index.js",
  "scripts": {
    "test": "jest --runInBand",
    "build": "tsc && npx ncc build",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "generate": "./node_modules/.bin/grpc_tools_node_protoc --ts_proto_out=. --ts_proto_opt=outputServices=nice-grpc,outputServices=generic-definitions,useExactTypes=false,forceLong=long ./src/rce/rce.proto"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.2",
    "@actions/exec": "^2.0.0",
    "@actions/io": "^2.0.0",
    "@kubernetes/client-node": "^1.3.0",
    "hooklib": "file:../hooklib",
    "js-yaml": "^4.1.0",
    "long": "^5.3.2",
    "nice-grpc": "^2.1.16",
    "shlex": "^3.0.0",
    "tar-fs": "^3.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@vercel/ncc": "^0.38.3",
    "babel-jest": "^30.1.1",
    "grpc-tools": "^1.13.1",
    "jest": "^30.1.1",
    "ts-jest": "^29.4.1",
    "ts-proto": "^2.11.6",
    "typescript": "^5.9.2"
  }
}
